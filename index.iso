<button id="fwBtn">13.02 - 13.52</button>

<p id="status">Select your PS4 Firmware</p>

<script>
  const btn = document.getElementById("fwBtn");
  const status = document.getElementById("status");

  btn.addEventListener("click", () => {
    status.textContent = "13.02 - 13.52 SELECTED";
  });
</script>
